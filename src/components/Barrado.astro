---
/** Barrado: a faixa de borda do piso. Divide seções e carrega uma linha de texto. */
interface Props {
  class?: string;
}
const { class: cls = "" } = Astro.props;
const id = `b${Math.random().toString(36).slice(2, 8)}`;
const temTexto = Astro.slots.has("default");
---

<div class:list={["barrado campo-fachada", cls]}>
  <svg class="faixa" aria-hidden="true" focusable="false" height="24" width="100%">
    <defs>
      <pattern id={id} width="24" height="24" patternUnits="userSpaceOnUse">
        <rect width="24" height="24" fill="var(--azul-fachada)"></rect>
        <path d="M0 24 L12 12 L24 24 Z" fill="var(--azul-meio)"></path>
        <path d="M12 2 L17 7 L12 12 L7 7 Z" fill="var(--azul-claro)"></path>
      </pattern>
    </defs>
    <rect width="100%" height="24" fill={`url(#${id})`}></rect>
  </svg>
  {
    temTexto && (
      <div class="linha">
        <div class="envoltorio">
          <slot />
        </div>
      </div>
    )
  }
</div>

<style>
  .barrado {
    background: var(--azul-fachada);
    color: var(--branco-esmalte);
  }
  .faixa {
    display: block;
    width: 100%;
  }
  .linha {
    padding: var(--e-4) 0 var(--e-5);
    font-family: var(--font-display);
    font-weight: 740;
    font-stretch: 112%;
    font-size: var(--fs-ladrilho);
    line-height: 1.2;
  }
</style>
