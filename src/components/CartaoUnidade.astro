---
/**
 * Cartão de unidade: tudo de uma loja junto (endereço, modo de exame, horário, WhatsApp).
 * É um ladrilho grande com o padrão da unidade no canto, não um card genérico.
 */
import Ladrilho from "./Ladrilho.astro";
import Selo from "./Selo.astro";
import Botao from "./Botao.astro";
import Icone from "./Icone.astro";
import EstadoUnidade from "./EstadoUnidade.astro";
import TabelaHorarios from "./TabelaHorarios.astro";
import { textoExame, textoDiaExame, linkWhatsApp, mensagemExame, type Unidade } from "../data/unidades";

interface Props {
  unidade: Unidade;
  demo?: boolean;
  /** true só quando o cartão é a única loja na tela (página da loja): WhatsApp em gema.
      Em listas de lojas, o WhatsApp vai em azul-fachada para respeitar a Regra da Gema. */
  destaque?: boolean;
  nivel?: "h2" | "h3";
  /** Página da loja: o título vira link. */
  href?: string;
}
const { unidade: u, demo = false, destaque = false, nivel = "h3", href } = Astro.props;
const Titulo = nivel;
const comNumero = u.whatsapp ? u : demo ? { ...u, whatsapp: "5521000000000" } : null;
const wa = comNumero ? linkWhatsApp(comNumero) : null;
const waExame = comNumero && u.exame.modo === "agendamento" ? linkWhatsApp(comNumero, mensagemExame(u)) : null;
---

<article class="unidade" aria-labelledby={`un-${u.id}`}>
  <div class="canto">
    <Ladrilho padrao={u.padrao} tom="fachada" rotulo={`Ladrilho da unidade ${u.nomeCurto}`} />
  </div>
  <div class="corpo">
    <Titulo id={`un-${u.id}`} class="titulo">
      {
        href ? (
          <a href={href} class="titulo-link">
            <span class="num">{u.numero}</span> {u.nome}
          </a>
        ) : (
          <>
            <span class="num">{u.numero}</span> {u.nome}
          </>
        )
      }
    </Titulo>
    <p class="bairro">{u.bairro}</p>
    <EstadoUnidade unidade={u} class="estado-cartao" />

    <dl class="fatos">
      <div>
        <dt><Icone nome="map-pin" tamanho={20} /><span class="sr-only">Endereço</span></dt>
        <dd>{u.endereco ?? <Selo tipo="pendente">Endereço a confirmar</Selo>}</dd>
      </div>
      {
        u.telefone && (
          <div>
            <dt><Icone nome="phone" tamanho={20} /><span class="sr-only">Telefone e WhatsApp</span></dt>
            <dd><a href={`tel:+${u.whatsapp}`} class="tel">{u.telefone}</a></dd>
          </div>
        )
      }
      <div>
        <dt><Icone nome="eye" tamanho={20} /><span class="sr-only">Exame de vista</span></dt>
        <dd>
          <Selo tipo="exame">{textoExame[u.exame.modo]}</Selo>
          <span class="dias">{textoDiaExame(u.exame)}. Gratuito na compra dos óculos.</span>
        </dd>
      </div>
      <div>
        <dt><Icone nome="clock" tamanho={20} /><span class="sr-only">Horário</span></dt>
        <dd class="dd-tabela"><TabelaHorarios unidade={u} /></dd>
      </div>
    </dl>

    <div class="acoes">
      {
        wa ? (
          <Botao href={wa} externo variante={destaque ? "primario" : "fachada"} icone="brand-whatsapp">
            WhatsApp da {u.nomeCurto}
          </Botao>
        ) : (
          <Selo tipo="pendente" icone="brand-whatsapp">WhatsApp a confirmar</Selo>
        )
      }
      {waExame && <Botao href={waExame} externo variante="linha" icone="calendar">Agendar exame</Botao>}
      {u.mapa && <Botao href={u.mapa} externo variante="linha" icone="route">Como chegar</Botao>}
    </div>
  </div>
</article>

<style>
  .unidade {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--branco-esmalte);
    border: var(--rejunte-w) solid var(--rejunte);
  }
  .canto {
    position: absolute;
    top: 0;
    right: 0;
    width: clamp(4.5rem, 22%, 7rem);
    border-left: var(--rejunte-w) solid var(--rejunte);
    border-bottom: var(--rejunte-w) solid var(--rejunte);
  }
  .corpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--e-2);
    padding: var(--e-5);
  }
  .num {
    color: var(--azul-meio);
    margin-right: 0.1em;
  }
  .titulo {
    font-size: var(--fs-subtitulo);
    line-height: 1.12;
    padding-right: clamp(4.5rem, 24%, 7.5rem);
  }
  .bairro {
    color: var(--texto-2);
  }
  .fatos {
    display: grid;
    gap: var(--e-3);
    margin: var(--e-4) 0 var(--e-2);
    padding-top: var(--e-4);
    border-top: 2px solid var(--azul-nevoa);
  }
  .fatos > div {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: var(--e-3);
    align-items: start;
  }
  dt {
    color: var(--azul-fachada);
    padding-top: 0.15rem;
  }
  dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-2) var(--e-3);
  }
  .titulo-link {
    text-decoration: none;
  }
  .titulo-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
  }
  .tel {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .dias {
    color: var(--texto-2);
    font-size: var(--fs-apoio);
    line-height: 1.4;
  }
  .dd-tabela {
    display: block;
  }
  .corpo :global(.estado-cartao) {
    margin-top: var(--e-1);
  }
  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-top: auto;
    padding-top: var(--e-4);
  }
</style>
