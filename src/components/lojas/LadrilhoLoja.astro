---
/**
 * Ladrilho-link de uma loja: a janela do padrão à esquerda e a placa esmalte com
 * número, nome, bairro e estado curto. Leva à página da loja.
 * Assenta num piso (o pai põe o rejunte). No hover o padrão dá o toque de 14°.
 */
import Ladrilho from "../Ladrilho.astro";
import Icone from "../Icone.astro";
import EstadoUnidade from "../EstadoUnidade.astro";
import { slugDe } from "../../data/lojas";
import type { Unidade } from "../../data/unidades";

interface Props {
  unidade: Unidade;
  nivel?: "h2" | "h3";
}
const { unidade: u, nivel = "h3" } = Astro.props;
const Titulo = nivel;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<a class="loja-tile" href={`${base}/lojas/${slugDe[u.id]}/`}>
  <span class="janela">
    <Ladrilho padrao={u.padrao} tom="claro" cobrir />
  </span>
  <span class="placa">
    <Titulo class="nome"><span class="num">{u.numero}</span> {u.nome}</Titulo>
    <span class="bairro">{u.bairro}</span>
    <EstadoUnidade unidade={u} exame={false} curto />
    <span class="ir">Ver a loja <Icone nome="arrow-right" tamanho={22} class="seta" /></span>
  </span>
</a>

<style>
  .loja-tile {
    display: grid;
    grid-template-columns: minmax(6rem, 9rem) minmax(0, 1fr);
    gap: var(--rejunte-w);
    background: var(--rejunte);
    color: var(--azul-noite);
    text-decoration: none;
    height: 100%;
  }
  .janela {
    display: block;
    overflow: hidden;
    background: var(--azul-claro);
  }
  .janela :global(.ladrilho) {
    height: 100%;
    aspect-ratio: auto;
    min-height: 100%;
  }
  .janela :global(.desenho) {
    transition: transform var(--dur-assenta) var(--ease-assenta);
  }
  .placa {
    display: grid;
    align-content: start;
    gap: var(--e-2);
    padding: var(--e-5);
    background: var(--branco-esmalte);
  }
  .nome {
    font-size: var(--fs-subtitulo);
    line-height: 1.12;
  }
  .num {
    color: var(--azul-meio);
    margin-right: 0.1em;
  }
  .bairro {
    color: var(--texto-2);
  }
  .ir {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    margin-top: var(--e-2);
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-size: var(--fs-acao);
    font-weight: 720;
    font-stretch: 112%;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .ir :global(.seta) {
    transition: transform var(--dur-rapido) ease-out;
  }
  .loja-tile:hover .placa {
    background: var(--azul-nevoa);
  }
  .loja-tile:hover :global(.desenho) {
    transform: rotate(14deg);
  }
  .loja-tile:hover .ir :global(.seta) {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .loja-tile:hover :global(.desenho) {
      transform: none;
    }
  }
  @media (max-width: 30rem) {
    .loja-tile {
      grid-template-columns: 5.5rem minmax(0, 1fr);
    }
    .placa {
      padding: var(--e-4);
    }
  }
</style>
