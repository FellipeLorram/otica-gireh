---
/** Tipos de lente (uma linha cada) e as combinações de tratamento mais comuns, em dois pisos lado a lado. */
import { tiposLente, combinacoes } from "../../data/oculos";
---

<div class="lentes">
  <div class="bloco">
    <h3>Tipos de lente</h3>
    <dl class="piso tipos">
      {
        tiposLente.map((t) => (
          <div class="tipo">
            <dt>{t.nome}</dt>
            <dd>{t.texto}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="bloco">
    <h3>Combinações mais comuns</h3>
    <ul class="piso combos" role="list">
      {
        combinacoes.map((c) => (
          <li class="combo">
            <p class="soma">
              {c.itens.map((i, n) => (
                <>
                  {n > 0 && (
                    <>
                      <span class="mais" aria-hidden="true">+</span>
                      <span class="sr-only"> mais </span>
                    </>
                  )}
                  <span class="parte">{i}</span>
                </>
              ))}
            </p>
            <p class="para">{c.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .lentes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--e-7);
    align-items: start;
  }
  .bloco {
    display: grid;
    gap: var(--e-4);
  }
  .piso {
    list-style: none;
    margin: 0;
    padding: var(--rejunte-w);
    display: grid;
    gap: var(--rejunte-w);
    background: var(--rejunte);
  }
  .tipo,
  .combo {
    display: grid;
    gap: var(--e-1);
    padding: var(--e-4) var(--e-5);
    background: var(--branco-esmalte);
  }
  dt,
  .soma {
    font-family: var(--font-display);
    font-size: var(--fs-ladrilho);
    font-weight: 780;
    font-stretch: 112%;
    line-height: 1.15;
    color: var(--azul-fachada);
  }
  dd {
    margin: 0;
    color: var(--texto-2);
  }
  .soma {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--e-2);
  }
  .mais {
    color: var(--azul-noite);
  }
  .para {
    color: var(--texto-2);
  }
  @media (max-width: 56rem) {
    .lentes {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--e-6);
    }
  }
</style>
