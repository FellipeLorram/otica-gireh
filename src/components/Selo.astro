---
/** Selo: informação curta de estado. Não é botão. */
import Icone from "./Icone.astro";
interface Props {
  tipo?: "exame" | "aberto" | "fechado" | "pendente" | "fachada";
  icone?: string;
  class?: string;
}
const { tipo = "exame", icone, class: cls = "" } = Astro.props;
---

<span class:list={["selo", `selo-${tipo}`, cls]}>
  {icone && <Icone nome={icone} tamanho={18} />}
  {(tipo === "aberto" || tipo === "fechado") && <span class="ponto" aria-hidden="true"></span>}
  <slot />
</span>

<style>
  .selo {
    display: inline-flex;
    align-items: center;
    gap: var(--e-2);
    padding: 0.3rem 0.6rem;
    border-radius: var(--raio);
    font-family: var(--font-display);
    font-size: var(--fs-mini);
    font-weight: 680;
    font-stretch: 108%;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }
  .selo-exame {
    background: var(--azul-claro);
    color: var(--azul-noite);
  }
  .selo-fachada {
    background: var(--azul-fachada);
    color: var(--branco-esmalte);
  }
  .selo-aberto {
    background: var(--aberto-fundo);
    color: var(--aberto-tinta);
  }
  .selo-fechado {
    background: var(--fechado-fundo);
    color: var(--fechado-tinta);
  }
  .selo-pendente {
    background: transparent;
    color: var(--texto-2);
    border: 1.5px dashed var(--azul-meio);
  }
  .ponto {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: currentColor;
  }
</style>
