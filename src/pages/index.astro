---
import Base from "../layouts/Base.astro";
import Cabecalho from "../components/Cabecalho.astro";
import Rodape from "../components/Rodape.astro";
import BarraAcao from "../components/BarraAcao.astro";
import Barrado from "../components/Barrado.astro";
import Botao from "../components/Botao.astro";
import Orcamento from "../components/Orcamento.astro";
import HeroPagina from "../components/HeroPagina.astro";
import Secao from "../components/Secao.astro";
import ComoFunciona from "../components/ComoFunciona.astro";
import AgendaExames from "../components/AgendaExames.astro";
import CartaoUnidade from "../components/CartaoUnidade.astro";
import Marcas from "../components/Marcas.astro";
import EspacoImagem from "../components/EspacoImagem.astro";
import { unidades, instagrams, schemaOtica } from "../data/unidades";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = (Astro.site?.toString() ?? "").replace(/\/$/, "");
const jsonld = {
  "@context": "https://schema.org",
  "@graph": unidades.map((u) => schemaOtica(u, site)),
};
---

<Base
  titulo="Ótica Girêh · Exame de vista gratuito na compra dos óculos"
  descricao="Exame de vista gratuito na compra dos óculos: sábado na Caju, por ordem de chegada; Pinheiro e Baixa do Sapateiro com agendamento. Orçamento pela foto da receita no WhatsApp."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonld)} />

  <Cabecalho atual="inicio" />

  <main>
    <HeroPagina
      frases={["Exame de vista", "gratuito na compra dos óculos."]}
      sub="Na Caju, é só chegar no sábado à tarde. Na Pinheiro e na Baixa do Sapateiro, o exame é com horário marcado pelo WhatsApp."
      faixa="Já tem receita? Mande a foto no WhatsApp e receba o orçamento."
      semBarra
    >
      <div slot="acoes" class="so-desktop">
        <Botao href="#lojas" variante="linha-clara" iconeFim="arrow-down">Ver lojas e horários</Botao>
      </div>
      <Orcamento slot="lado" modo="exame" />
    </HeroPagina>

    <Secao titulo="Como pedir o orçamento">
      <ComoFunciona />
      <p class="apoio">
        Ainda não tem receita? <a href="#exame">Faça o exame de vista na loja</a>. Ele é gratuito na compra dos
        óculos.
      </p>
    </Secao>

    <Secao
      id="exame"
      campo="fachada"
      titulo="Sábado na Caju e na Pinheiro. Sexta na Baixa."
      lead="O exame de vista é gratuito na compra dos óculos. Na Caju é por ordem de chegada. Na Pinheiro e na Baixa do Sapateiro, com horário marcado pelo WhatsApp."
    >
      <AgendaExames />
      <div>
        <Botao href={`${base}/exame-de-vista/`} variante="linha-clara" iconeFim="arrow-right">Tudo sobre o exame</Botao>
      </div>
    </Secao>

    <Secao id="lojas" titulo="As três lojas" lead="Cada loja tem horário e WhatsApp próprios. O selo mostra se ela está aberta agora.">
      <div class="lojas">
        {unidades.map((u) => <CartaoUnidade unidade={u} />)}
      </div>
    </Secao>

    <Barrado />

    <Secao titulo="Marcas que você encontra na Girêh">
      <Marcas />
      <div>
        <Botao href={`${base}/oculos-e-lentes/`} variante="linha" iconeFim="arrow-right">Óculos e lentes</Botao>
      </div>
    </Secao>

    <Secao titulo="Na loja">
      <div class="fotos">
        <EspacoImagem codigo="F04" descricao="Equipe atendendo no balcão" proporcao="livre" class="f-grande" />
        <EspacoImagem codigo="F09" descricao="Expositor de armações na parede" proporcao="livre" class="f-peq" />
        <EspacoImagem codigo="F01" descricao="Fachada da Girêh Caju, de frente, de dia" proporcao="livre" class="f-peq" />
      </div>
    </Secao>

    <Secao campo="fachada" class="insta">
      <div class="insta-grade">
        <div>
          <h2>Novidades no Instagram</h2>
          <p class="insta-sub">Lançamentos, promoções e o dia a dia das lojas.</p>
        </div>
        <ul class="insta-links" role="list">
          {
            instagrams.map((i) => (
              <li>
                <Botao href={i.url} externo variante="linha-clara" icone="brand-instagram">
                  @{i.usuario}
                </Botao>
              </li>
            ))
          }
        </ul>
      </div>
    </Secao>
  </main>

  <Rodape />
  <BarraAcao />
</Base>

<style>
  @media (max-width: 56rem) {
    .so-desktop {
      display: none;
    }
  }
  .apoio {
    font-size: var(--fs-corpo-g);
  }
  .apoio a {
    font-weight: 700;
  }

  /* As três lojas assentadas num piso só: rejunte entre os cartões, alturas iguais. */
  .lojas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    gap: var(--rejunte-w);
    padding: var(--rejunte-w);
    background: var(--rejunte);
  }
  .lojas :global(.unidade) {
    border: 0;
  }

  .fotos {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--rejunte-w);
    padding: var(--rejunte-w);
    background: var(--rejunte);
  }
  .fotos :global(.f-grande) {
    grid-row: span 2;
    height: 100%;
  }
  .fotos :global(.f-peq) {
    aspect-ratio: 3 / 2;
  }
  .fotos :global(.espaco) {
    border: 0;
  }
  @media (max-width: 40rem) {
    .fotos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .fotos :global(.f-grande) {
      grid-row: auto;
      grid-column: 1 / -1;
      aspect-ratio: 4 / 3;
    }
    .fotos :global(.f-peq) {
      aspect-ratio: 1;
      padding: var(--e-3);
    }
  }

  .insta-grade {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--e-5);
  }
  .insta-sub {
    margin-top: var(--e-3);
    color: var(--texto-2-escuro);
    font-size: var(--fs-corpo-g);
  }
  .insta-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
