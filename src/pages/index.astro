---
import Base from "../layouts/Base.astro";
import Cabecalho from "../components/Cabecalho.astro";
import Rodape from "../components/Rodape.astro";
import BarraAcao from "../components/BarraAcao.astro";
import Barrado from "../components/Barrado.astro";
import Botao from "../components/Botao.astro";
import Orcamento from "../components/Orcamento.astro";
import ComoFunciona from "../components/ComoFunciona.astro";
import AgendaExames from "../components/AgendaExames.astro";
import CartaoUnidade from "../components/CartaoUnidade.astro";
import Marcas from "../components/Marcas.astro";
import EspacoImagem from "../components/EspacoImagem.astro";
import { unidades, instagrams, schemaOtica } from "../data/unidades";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const site = (Astro.site?.toString() ?? "").replace(/\/$/, "");
const jsonld = {
  "@context": "https://schema.org",
  "@graph": unidades.map((u) => schemaOtica(u, site)),
};
---

<Base
  titulo="Ótica Girêh · Exame de vista gratuito na compra dos óculos"
  descricao="Exame de vista gratuito na compra dos óculos: sábado na Caju, por ordem de chegada; Pinheiro e Baixa do Sapateiro com agendamento. Orçamento pela foto da receita no WhatsApp."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonld)} />

  <Cabecalho atual="inicio" />

  <main>
    <section class="hero campo-fachada" id="inicio" aria-labelledby="h-hero" data-sem-barra>
      <div class="envoltorio hero-grade">
        <div class="hero-texto">
          <h1 id="h-hero">
            <span class="frase">Exame de vista</span>
            <span class="frase">gratuito na compra dos óculos.</span>
          </h1>
          <p class="hero-sub">
            Na Caju, é só chegar no sábado à tarde. Na Pinheiro e na Baixa do Sapateiro, o exame é com horário marcado
            pelo WhatsApp.
          </p>
          <div class="hero-acoes">
            <Botao href="#lojas" variante="linha-clara" iconeFim="arrow-down">Ver lojas e horários</Botao>
          </div>
        </div>
        <div class="hero-piso">
          <Orcamento modo="exame" />
        </div>
      </div>
    </section>

    <Barrado>Já tem receita? Mande a foto no WhatsApp e receba o orçamento.</Barrado>

    <section class="secao" aria-labelledby="h-como">
      <div class="envoltorio pilha">
        <h2 id="h-como">Como pedir o orçamento</h2>
        <ComoFunciona />
        <p class="apoio">
          Ainda não tem receita? <a href="#exame">Faça o exame de vista na loja</a>. Ele é gratuito na compra dos
          óculos.
        </p>
      </div>
    </section>

    <section class="secao campo-fachada exame" id="exame" aria-labelledby="h-exame">
      <div class="envoltorio pilha">
        <h2 id="h-exame">Sábado na Caju e na Pinheiro. Sexta na Baixa.</h2>
        <p class="lead">
          O exame de vista é gratuito na compra dos óculos. Na Caju é por ordem de chegada. Na Pinheiro e na Baixa do
          Sapateiro, com horário marcado pelo WhatsApp.
        </p>
        <AgendaExames />
        <div>
          <Botao href={`${base}/exame-de-vista/`} variante="linha-clara" iconeFim="arrow-right">Tudo sobre o exame</Botao>
        </div>
      </div>
    </section>

    <section class="secao" id="lojas" aria-labelledby="h-lojas">
      <div class="envoltorio pilha">
        <h2 id="h-lojas">As três lojas</h2>
        <p class="lead">Cada loja tem horário e WhatsApp próprios. O selo mostra se ela está aberta agora.</p>
        <div class="lojas">
          {unidades.map((u) => <CartaoUnidade unidade={u} />)}
        </div>
      </div>
    </section>

    <Barrado />

    <section class="secao" aria-labelledby="h-marcas">
      <div class="envoltorio pilha">
        <h2 id="h-marcas">Marcas que você encontra na Girêh</h2>
        <Marcas />
        <div>
          <Botao href={`${base}/oculos-e-lentes/`} variante="linha" iconeFim="arrow-right">Óculos e lentes</Botao>
        </div>
      </div>
    </section>

    <section class="secao" aria-labelledby="h-fotos">
      <div class="envoltorio pilha">
        <h2 id="h-fotos">Na loja</h2>
        <div class="fotos">
          <EspacoImagem codigo="F04" descricao="Equipe atendendo no balcão" proporcao="livre" class="f-grande" />
          <EspacoImagem codigo="F09" descricao="Expositor de armações na parede" proporcao="livre" class="f-peq" />
          <EspacoImagem codigo="F01" descricao="Fachada da Girêh Caju, de frente, de dia" proporcao="livre" class="f-peq" />
        </div>
      </div>
    </section>

    <section class="secao insta campo-fachada" aria-labelledby="h-insta">
      <div class="envoltorio insta-grade">
        <div>
          <h2 id="h-insta">Novidades no Instagram</h2>
          <p class="insta-sub">Lançamentos, promoções e o dia a dia das lojas.</p>
        </div>
        <ul class="insta-links" role="list">
          {
            instagrams.map((i) => (
              <li>
                <Botao href={i.url} externo variante="linha-clara" icone="brand-instagram">
                  @{i.usuario}
                </Botao>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <Rodape />
  <BarraAcao />
</Base>

<style>
  .hero {
    background: var(--azul-fachada);
    color: var(--branco-esmalte);
    padding: var(--e-7) 0 var(--e-8);
  }
  .hero-grade {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--e-7);
    align-items: center;
  }
  .hero-texto {
    display: grid;
    gap: var(--e-5);
  }
  .frase {
    display: block;
  }
  .frase + .frase {
    color: var(--azul-claro);
  }
  .hero-sub {
    max-width: 40ch;
    font-size: var(--fs-corpo-g);
    color: var(--texto-2-escuro);
  }
  .hero-acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
  }
  .hero-piso {
    width: 100%;
    max-width: 36rem;
    justify-self: end;
  }
  @media (max-width: 56rem) {
    .hero {
      padding: var(--e-6) 0 var(--e-7);
    }
    .hero-grade {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--e-6);
    }
    .hero-piso {
      justify-self: stretch;
      max-width: none;
    }
    .hero-acoes {
      display: none;
    }
  }

  .secao {
    padding: var(--e-9) 0;
  }
  @media (max-width: 48rem) {
    .secao {
      padding: var(--e-8) 0;
    }
  }
  .exame {
    background: var(--azul-fachada);
    color: var(--branco-esmalte);
  }
  .exame .lead {
    color: var(--texto-2-escuro);
  }
  .pilha {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--e-5);
  }
  .pilha > h2 {
    max-width: 22ch;
  }
  .lead {
    max-width: var(--medida);
    font-size: var(--fs-corpo-g);
    color: var(--texto-2);
    margin-top: calc(-1 * var(--e-2));
  }
  .apoio {
    font-size: var(--fs-corpo-g);
  }
  .apoio a {
    font-weight: 700;
  }

  /* As três lojas assentadas num piso só: rejunte entre os cartões, alturas iguais. */
  .lojas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    gap: var(--rejunte-w);
    padding: var(--rejunte-w);
    background: var(--rejunte);
  }
  .lojas :global(.unidade) {
    border: 0;
  }

  .fotos {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: var(--rejunte-w);
    padding: var(--rejunte-w);
    background: var(--rejunte);
  }
  .fotos :global(.f-grande) {
    grid-row: span 2;
    height: 100%;
  }
  .fotos :global(.f-peq) {
    aspect-ratio: 3 / 2;
  }
  .fotos :global(.espaco) {
    border: 0;
  }
  @media (max-width: 40rem) {
    .fotos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .fotos :global(.f-grande) {
      grid-row: auto;
      grid-column: 1 / -1;
      aspect-ratio: 4 / 3;
    }
    .fotos :global(.f-peq) {
      aspect-ratio: 1;
      padding: var(--e-3);
    }
  }

  .insta {
    background: var(--azul-fachada);
    color: var(--branco-esmalte);
    padding: var(--e-8) 0;
  }
  .insta-grade {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--e-5);
  }
  .insta-sub {
    margin-top: var(--e-3);
    color: var(--texto-2-escuro);
    font-size: var(--fs-corpo-g);
  }
  .insta-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
